# ============================================================
# Network Intelligence — пример конфигурации окружения (.env)
# Скопируйте этот файл в .env и подставьте свои значения.
# ВАЖНО: реальные токены в репозиторий не загружаются (.env в .gitignore).
# ============================================================

# ── Бот платформы MAX ────────────────────────────────────────────────
# Токен чат-бота MAX (выдаётся организаторами хакатона).
# Используется для long-polling обновлений (GET /updates), отправки
# сообщений (POST /messages) и регистрации команд (PATCH /me/commands)
# на https://platform-api2.max.ru
MAX_BOT_TOKEN=your_max_bot_token_here

# ── Бот Telegram (опционально, дублирование уведомлений) ─────────────
# Токен Telegram-бота от @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Тестовый Telegram/Max User ID и Chat ID
# (используется веб-интерфейсом и API вместо полноценной авторизации)
TELEGRAM_CHAT_ID=503362430

# ── База данных MySQL ────────────────────────────────────────────────
# Параметры читаются в src/database/connection.ts.
# В Docker (compose.yaml) они переопределяются на служебное имя db.
DB_HOST=localhost
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=network_intelligence

# ── Веб-интерфейс и Mini App (адрес API для браузера) ────────────────
# Локально можно не задавать — по умолчанию http://localhost:3000.
# На сервере (VPS) укажите публичный адрес API, например:
# VITE_API_BASE_WEB=https://api.megafonhome.ru
# VITE_API_BASE_MINI=https://api.megafonhome.ru